<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-8 offset-2">

    <h3><b><%= listing.title %></b><br></h3>
    </div>

    <div class="card col-6 offset-2 show-card listing-card">
        <img
        src="<%= listing.image.url %>"
        class="card-img-top show-img"
        alt="listing_image" height="300px" width="400px"/>

        <div class="card-body">
            
            <p class="card-text">Owned by <i><%= listing.owner.username %></i></p>
            <p class="card-text">    <%= listing.description %></p>
            <p class="card-text">    &#8377;<%= listing.price %></p>
            <p class="card-text">    <%= listing.location %></p>
            <p class="card-text">    <%= listing.country %></p>
         
        </div>
    </div>

    <% if(currUser) { %>
    <div class="card col-6 offset-2 mt-3 p-3">
        <h5>Book this place</h5>
        <form action="/listings/<%= listing._id %>/book" method="post">
            <div class="row">
                <div class="col-md-4 mb-2">
                    <label class="form-label">Check-in</label>
                    <input type="date" name="booking[checkIn]" class="form-control" required min="<%= new Date().toISOString().split('T')[0] %>"/>
                </div>
                <div class="col-md-4 mb-2">
                    <label class="form-label">Check-out</label>
                    <input type="date" name="booking[checkOut]" class="form-control" required min="<%= new Date().toISOString().split('T')[0] %>"/>
                </div>
                <div class="col-md-4 mb-2">
                    <label class="form-label">Guests</label>
                    <input type="number" name="booking[guests]" class="form-control" min="1" value="1" required/>
                </div>
            </div>
            <button class="btn btn-dark mt-2">Reserve</button>
        </form>
    </div>
    <% } else { %>
    <div class="col-6 offset-2 mt-3">
        <p><a href="/login">Log in</a> to book this place.</p>
    </div>
    <% } %>

    <br>
    
    <br>
 
<div class="btns">
    <a href="/listings/<%= listing._id %>/edit" 
        class="btn btn-dark col-1 offset-3 edit-btn">Edit</a>
 

    <form method="post" action="/listings/<%=listing._id%>?_method=DELETE">
        <button style="margin-left:30px ;" class= "btn btn-dark offset-5"> Delete </button>
    </form>

    <% if(currUser) { %>
    <form method="post" action="/listings/<%= listing._id %>/favorite" class="d-inline ms-2">
        <% if(isFavorited) { %>
            <button class="btn btn-danger"><i class="fa-solid fa-heart"></i> Remove from Wishlist</button>
        <% } else { %>
            <button class="btn btn-outline-danger"><i class="fa-regular fa-heart"></i> Add to Wishlist</button>
        <% } %>
    </form>
    <% } %>
    </div>

   
    <div class="col-8 offset-3">
        <hr/>
         <% if(currUser) { %>
        <h4>Leave a Review</h4>
        
        <form action="/listings/<%= listing.id %>/review" method="post" novalidate class="needs-validation">
            <div class="mb-3 mt-3">
            <fieldset class="starability-slot">
                <!--<legend>First rating:</legend> -->
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
            </div>
            <div>
                <label for="comment" class="form-label">Comments</label><br>   
                <textarea name="review[comment]" cols="50" rows="3" ></textarea>

                <div class="invalid-feedback">
                please submit soe comments for review
            </div>
            </div>
            
            <button class="btn btn-outline-dark">Submit</button>
        </form>
        <% } %>
    <hr />

    <h4>All Reviews</h4>
    <ul>
        <% for(rw of listing.review){%>
    <div class="card cols-5 ms-3 mb-3" style="border: 2px solid black;">
            <div class="card-body">
                <div class="card-title"><b>@<%= rw.author.username %></b></div>
                <p class="starability-result card-text"
               data-rating ="<%= rw.rating %>"></p> 
               <p class="card-text"><%= rw.comment %></p>
               
               <form class="mb-3" method="post" action="/listings/<%= listing._id %>/review/<%= rw._id %>?_method=DELETE">
                    <button class="btn btn-sm btn-dark">Delete</button>
                </form>
            </div>
        </div>
    <% } %>
    </ul>
    </div>
</div>
