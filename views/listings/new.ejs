<% layout('/layouts/boilerplate') %>
<div class="row">
    <div class="col-8 offset-2" >

   
    <h3>Create a New Listing</h3>
    <form method="post" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">

        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
             <input name="listing[title]" class="form-control" type="text" placeholder="Add a catchy title" required />
        </div>
       
        <div class="mb-3">
             <label for="description" class="form-label">Description</label>
             <textarea name="listing[description]" class="form-control" type="text" required></textarea>
        </div>


       <div class="mb-3">
            <label for="image" class="form-label">Upload Listing Image </label>
            <input name="listing[image]" class="form-control" type="file" >
       </div>

       <div class="row">
            <div class="mb-3 col-md-4">
        <label for="price" class="form-label" >Price</label>
        <input name="listing[price]" class="form-control" type="number" placeholder="1200" required/>
       </div>
        
       <div class="mb-3 col-md-8">
        <label for="country" class="form-label">Country</label>
        <input name="listing[country]" class="form-control" type="text" placeholder="india" required/>
       </div>
       </div>
       
        
       <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input name="listing[location]" class="form-control" type="text" placeholder="jaipur,Rajasthan" required/>
       </div>
        
        <button class="btn btn-dark add-btn">Add</button>
    </form>
     </div>
</div>
    
