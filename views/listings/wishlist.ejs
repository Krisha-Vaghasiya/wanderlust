<% layout('layouts/boilerplate') %>

<h3 class="mb-4 mt-3">My Wishlist</h3>

<% if (favorites.length === 0) { %>
  <div class="text-center mt-5">
    <h5>Your wishlist is empty</h5>
    <p>Browse listings and tap the heart icon to save your favorites.</p>
    <a href="/listings" class="btn btn-dark mt-2">Explore Listings</a>
  </div>
<% } else { %>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
    <% for (let listing of favorites) { %>
        <a href="/listings/<%= listing._id %>" class="listing-link">
          <div class="card col listing-card">
            <img
              src="<%= listing.image.url %>"
              class="card-img-top"
              style="height: 20rem"
            />
            <div class="card-body">
              <p class="card-text">
                <b><%= listing.title %></b><br>
                &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "0" %> / night
              </p>
            </div>
          </div>
        </a>
    <% } %>
</div>
<% } %>